GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Leave MONGODB_URI out to keep using the local JSON file for development.
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?appName=ClearanceLink
MONGODB_DB=clearancelink

# Free trial (volume-limited) and subscription plans
TRIAL_DAYS=7
SUBSCRIPTION_DAYS=365

# Paystack (paid plans). Prices are in the currency below, per subscription period.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
ENTERPRISE_CONTACT_EMAIL=sales@your-domain.com

# Plan prices are in US dollars (monthly) and are converted to each institution's local currency.
PLAN_STARTER_PRICE_USD=25
PLAN_STANDARD_PRICE_USD=60
PLAN_PRO_PRICE_USD=120
ENTERPRISE_PRICE_FROM_USD=250
# Currencies Paystack can charge on your account; other countries are charged in USD.
PAYSTACK_CURRENCIES=NGN,GHS,KES,ZAR,USD

# Cloudinary: private storage for uploaded files (logos, documents, stamps, ID cards)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
