GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Leave MONGODB_URI out to keep using the local JSON file for development.
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?appName=ClearanceLink
MONGODB_DB=clearancelink

# Public API: set NODE_ENV=production and list the exact website origins that may call it.
NODE_ENV=development
PLATFORM_ADMIN_EMAIL=thegideons.2.5.1@gmail.com
DEMO_ACCOUNT_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only enable this if your trusted reverse proxy sets X-Forwarded-For correctly.
TRUST_PROXY=0
MAX_INFLIGHT_REQUESTS=250
MAX_REQUESTS_PER_MINUTE=1200
# Local development only; never enable for a public API.
ALLOW_DEV_VERIFY=0

# iOS push credentials for EAS. Keep the private key file outside this repository.
# This path is used when uploading the Apple Push Key to EAS; the app and API
# continue to use Expo push tokens and never read the private key directly.
APNS_AUTH_KEY_PATH=C:/path/to/AuthKey_KEY_ID.p8
APNS_KEY_ID=YOUR_APPLE_PUSH_KEY_ID

# Free trial (volume-limited) and subscription plans
TRIAL_DAYS=7
SUBSCRIPTION_DAYS=365

# Paystack (paid plans). Prices are in the currency below, per subscription period.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
ENTERPRISE_CONTACT_EMAIL=sales@your-domain.com

# Plan prices are in US dollars (monthly) and are converted to each institution's local currency.
PLAN_STARTER_PRICE_USD=25
PLAN_STANDARD_PRICE_USD=60
PLAN_PRO_PRICE_USD=120
ENTERPRISE_PRICE_FROM_USD=250
# Currencies Paystack can charge on your account; other countries are charged in USD.
PAYSTACK_CURRENCIES=NGN,GHS,KES,ZAR,USD

# Cloudinary: private storage for uploaded files (logos, documents, stamps, ID cards)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Paystack: checkout redirect (the app intercepts it) and the webhook address to paste in the Paystack dashboard
PAYMENT_CALLBACK_URL=https://clearancelink.emmanuelsolomon.ca/payment/complete
PAYSTACK_WEBHOOK_URL=https://clearancelink.emmanuelsolomon.ca/api/paystack/webhook
